# Database (MySQL 8)
DATABASE_URL="mysql://user:password@localhost:3306/punchbug"

# NextAuth — generate a secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# SendGrid (for sending invite and magic link emails)
# Get your API key from SendGrid → Settings → API Keys (Full Access or Mail Send)
SENDGRID_API_KEY=""
EMAIL_FROM="\"Punch - Site QA\" <noreply@punchteam.com>"

# File storage provider: "local", "r2", or "cloudinary"
STORAGE_PROVIDER="local"

# Cloudflare R2 (when STORAGE_PROVIDER=r2)
# Create an R2 bucket, generate an API token with Object Read+Write, enable public access.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=punchbug
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_URL=https://pub-<hash>.r2.dev   (or your custom domain e.g. https://cdn.yourdomain.com)

# Local uploads base directory — set to an absolute path OUTSIDE the deploy folder
# so that uploads survive redeployments. On Hostinger, point to public_html/uploads.
# On Hostinger: LOCAL_UPLOAD_DIR=/home/<user>/domains/<domain>/public_html/uploads
LOCAL_UPLOAD_DIR="public/uploads"

# When LOCAL_UPLOAD_DIR is accessible via the web server as static files,
# set this to its public URL so Node.js returns direct URLs instead of proxying.
# On Hostinger: UPLOADS_STATIC_URL=https://yourdomain.com/uploads
UPLOADS_STATIC_URL=""

# Cloudinary (only needed if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public URLs (used by embed widget)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_EMBED_URL="http://localhost:3000/embed.js"

# Screenshot microservice — server-side URL Node.js uses to call the capture service
# Required in production: point to your ss_service droplet IP
SCREENSHOT_SERVICE_URL="http://YOUR_SS_SERVICE_DROPLET_IP:8000"

# API key set in ss_service .env — must match API_KEY on the screenshot droplet
SCREENSHOT_SERVICE_API_KEY=""

# Public URL injected into the embed snippet (client-side task screenshots)
NEXT_PUBLIC_SCREENSHOT_SERVER_URL=""

# Database (MySQL 8)
DATABASE_URL="mysql://user:password@localhost:3306/punchbug"

# NextAuth — generate a secret: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# Google OAuth (from console.cloud.google.com)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# File storage: "local" or "cloudinary"
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="public/uploads"

# Cloudinary (only needed if STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Public URLs (used by embed widget)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_EMBED_URL="http://localhost:3000/embed.js"

# Screenshot microservice — server-side URL Node.js uses to call the capture service
# On production, point to your VPS (e.g. http://148.230.86.205:8000)
SCREENSHOT_SERVICE_URL="http://127.0.0.1:8000"

# Public URL injected into the embed snippet (client-side task screenshots)
# On production, same VPS address but publicly reachable
NEXT_PUBLIC_SCREENSHOT_SERVER_URL=""

# Where to store project thumbnail screenshots (must survive redeployments)
# On Hostinger: /home/<user>/domains/<domain>/public_html/screenshots
SCREENSHOTS_DIR=""

# Optional: if set, the screenshot GET route redirects here instead of piping through Node.js
# Lets the web server (LiteSpeed/Nginx) serve images directly as static files
# On Hostinger: https://yourdomain.com/screenshots
SCREENSHOTS_STATIC_URL=""

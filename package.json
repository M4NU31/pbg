{
  "name": "punchbug-root",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "mysql2": "^3.11.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build:embed && cd apps/web && npx prisma generate && npx next build",
    "build:embed": "npm run build --workspace=packages/embed",
    "start": "npm run start --workspace=apps/web",
    "db:migrate": "npm run db:migrate --workspace=apps/web",
    "db:studio": "npm run db:studio --workspace=apps/web"
  }
}
